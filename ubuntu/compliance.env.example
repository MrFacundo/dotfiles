# Copy to ubuntu/compliance.env and fill in from the Help Desk Knowledge Base
# (intranet, needs authentication). compliance.env is gitignored - the URLs are
# signed and the tokens are corporate secrets, so it must never be committed.
#
#   Compliance Requirements for Linux Computers
#   How to install FortiClient ZTNA - Linux
#   How to install Rapid7 Insight Agent
#   How to install Defender for Endpoint - Linux

# ---- Rapid7 Insight Agent ----
# Signed blob URL of the .deb, and the version string it unpacks to.
RAPID7_DEB_URL=""
RAPID7_VERSION="4.0.20.15"
RAPID7_TOKEN=""

# ---- Defender for Endpoint ----
# Signed blob URL of linux_onboarding_script.py.
DEFENDER_ONBOARDING_URL=""

# ---- FortiClient ZTNA ----
# Zero Trust Telemetry registration code, entered in the GUI.
FORTICLIENT_CODE=""
